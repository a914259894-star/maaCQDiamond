{
    // ============================================================
    // 战斗：确认进入战斗后，就一直盲点最右侧方块；
    //       每轮盲点之间识别一次领主 / 女神进度条上有没有 TOUCH，有就点。
    //
    // v2.0.6 实测：TOUCH 检查挂在 15 连点之后，识别周期 ~2.2s，用户反馈
    // 领主/女神「点的太慢」。v2.0.7 改成 3 连点小循环：Tap1→Tap2→Tap3→
    // 查领主/女神→回 Tap1。TOUCH 出现后的最长响应延迟从 ~2.2s 压到 ~0.3s。
    // 代价只是每轮多两次模板匹配（同一帧上比较，无额外截图），盲点频率不变。
    //
    // 领主 TOUCH 可能连续触发（x3），所以点完领主立刻再查领主+女神，
    // 点完女神也一样；横幅都消失才回去继续盲点。
    //
    // 【与 v2.0.21 统一入口架构的关系】
    //   这是全工程唯一保留的「页内循环」：一场战斗要连点几十次，
    //   每点一下就回 Main 做 20 多个页面的全屏判别会从 3 次/秒掉到 1 次/秒，
    //   用户明确要求过点击速度。战斗页识别（Page_Battle）本身很稳，
    //   且结算页已挂在循环的 next 里，不会出现"打完不知道"的情况。
    //   「回入口」的语义在一场战斗结束时履行：Page_Result 之后全部回 Main。
    //
    // 用户实测：反作弊弹窗只在主城出现，战斗链不需要任何弹窗检查——
    // 战斗链保持纯粹「连点 + TOUCH 判定」，不加门禁，避免多余开销。
    // ============================================================
    "Page_Battle": {
        "recognition": "TemplateMatch",
        "template": [
            "m_battle.png"
        ],
        "roi": [
            1200,
            0,
            80,
            60
        ],
        "threshold": 0.85,
        "action": "DoNothing",
        "next": [
            "Battle_Tap1"
        ],
        "rate_limit": 0
    },
    "Battle_Tap1": {
        "recognition": "DirectHit",
        "action": "Click",
        "target": [
            1156,
            634
        ],
        "next": [
            "Battle_Tap2"
        ],
        "rate_limit": 0,
        "post_delay": 0
    },
    "Battle_Tap2": {
        "recognition": "DirectHit",
        "action": "Click",
        "target": [
            1156,
            634
        ],
        "next": [
            "Battle_Tap3"
        ],
        "rate_limit": 0,
        "post_delay": 0
    },
    "Battle_Tap3": {
        "recognition": "DirectHit",
        "action": "Click",
        "target": [
            1156,
            634
        ],
        "next": [
            "Battle_Lord",
            "Battle_God",
            "Page_Result",
            "Battle_Tap1"
        ],
        "rate_limit": 0,
        "post_delay": 0
    },

    // 领主：进度条上出现 TOUCH 横幅 → 点领主按钮。
    // 实测横幅左缘可达 x≈731，模板宽 166px，旧 roi x755 起根本装不下模板（漏检），
    // v2.0.6 放宽到 x690-990
    //
    // v2.0.23 关键修复：next 去掉自己，不再「点完立刻再查领主」。
    // 依据 v2.0.20 日志：TOUCH 横幅出现后连点 19-22 次（8-18 秒）都不消失
    // （视频里用户手动玩时横幅同样留到战斗结束——横幅上带 x3，可能需要多次
    // 点击或另有发动方式），自循环期间方块条零点击 → 队伍站桩 → 战斗失败。
    // 现在每轮 3 连点后最多点一次 TOUCH 就回 Tap1，横幅若需多次点击，
    // 每轮 ~1 秒点一次照样累计；点不掉也不阻塞方块，战斗不再停摆。
    "Battle_Lord": {
        "recognition": "TemplateMatch",
        "template": [
            "m_touch.png"
        ],
        "roi": [
            690,
            525,
            300,
            70
        ],
        "threshold": 0.8,
        "action": "Click",
        "target": [
            830,
            562
        ],
        "next": [
            "Battle_God",
            "Page_Result",
            "Battle_Tap1"
        ],
        "rate_limit": 0
    },
    // 女神：蓝色 TOUCH 横幅出现在右侧能量槽上 → 点女神按钮。
    // v2.0.6 关键修复：蓝色横幅和领主的红色横幅颜色不同，旧红模板在蓝横幅上
    // 只能到 0.54，永远够不到 0.8 阈值——这就是「女神不点了」的根因。
    // 新模板 m_touch_god.png 裁自真实蓝横幅：正例 1.0 / 负例 ≤0.43
    "Battle_God": {
        "recognition": "TemplateMatch",
        "template": [
            "m_touch_god.png"
        ],
        "roi": [
            1000,
            525,
            270,
            70
        ],
        "threshold": 0.8,
        "action": "Click",
        "target": [
            1140,
            562
        ],
        "next": [
            "Page_Result",
            "Battle_Tap1"
        ],
        "rate_limit": 0
    },

    // ============================================================
    // 结算：按按钮颜色决定 继续 / 重打 / 结束
    // ============================================================
    "Page_Result": {
        "recognition": "TemplateMatch",
        "template": [
            "m_result.png"
        ],
        "roi": [
            200,
            595,
            860,
            85
        ],
        "threshold": 0.85,
        "action": "DoNothing",
        // 结算动画还没放完时按钮是暗的，等一下再判颜色，否则会误判成「次数用尽」
        "pre_delay": 800,
        "next": [
            "Popup_Confirm",
            // STAGE FAIL（战斗失败）：按钮布局和 CLEAR 页完全不同（y≈510-560 vs 615-660），
            // 下面的颜色判断全部落空、Result_Town 会盲点空白处。必须在它们之前拦截。
            // 点「试炼主页」回试炼页：还有次数就接着打（按钮蓝），没次数 OCR 0次 进删号
            "Result_Fail",
            "Result_Next",
            "Result_Retry",
            "Result_Town"
        ],
        "rate_limit": 0
    },
    // STAGE FAIL（战斗失败）：金色横幅模板 m_fail.png（正例 1.0 / 负例 ≤0.585）。
    // 规则（用户钦定，v2.0.14）：
    //   「重新挑战」是蓝色（还有次数）→ 点重新挑战；
    //   「重新挑战」是灰色（次数用完）→ 点返回城镇，回主城后由试炼页 OCR 0次 进删号链。
    // 像素实测（有次数/无次数两张真实 FAIL 页）：
    //   重新挑战按钮 x440-651 y595-663：有次数蓝色占比 0.743 / 无次数 0.000
    //   返回城镇绿色块中心 (992,631)，两种页面位置一致
    "Result_Fail": {
        "recognition": "TemplateMatch",
        "template": [
            "m_fail.png"
        ],
        "roi": [
            300,
            50,
            700,
            100
        ],
        "threshold": 0.85,
        "action": "DoNothing",
        "next": [
            "Result_Fail_Retry",
            "Result_Fail_Town"
        ],
        "rate_limit": 0
    },
