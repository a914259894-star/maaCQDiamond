{
    // ============================================================
    // 战斗：确认进入战斗后，就一直盲点最右侧方块；
    //       每轮盲点之间识别一次领主 / 女神进度条上有没有 TOUCH，有就点。
    //
    // v2.0.6 实测：TOUCH 检查挂在 15 连点之后，识别周期 ~2.2s，用户反馈
    // 领主/女神「点的太慢」。v2.0.7 改成 3 连点小循环：Tap1→Tap2→Tap3→
    // 查领主/女神→回 Tap1。TOUCH 出现后的最长响应延迟从 ~2.2s 压到 ~0.3s。
    // 代价只是每轮多两次模板匹配（同一帧上比较，无额外截图），盲点频率不变。
    //
    // 领主 TOUCH 可能连续触发（x3），所以点完领主立刻再查领主+女神，
    // 点完女神也一样；横幅都消失才回去继续盲点。
    // ============================================================
    "Page_Battle": {
        "recognition": "TemplateMatch",
        "template": [
            "m_battle.png"
        ],
        "roi": [
            1200,
            0,
            80,
            60
        ],
        "threshold": 0.85,
        "action": "DoNothing",
        "next": [
            "Battle_Tap1"
        ],
        "rate_limit": 0
    },
    "Battle_Tap1": {
        "recognition": "DirectHit",
        "action": "Click",
        "target": [
            1156,
            634
        ],
        "next": [
            "Battle_Tap2"
        ],
        "rate_limit": 0,
        "post_delay": 0
    },
    "Battle_Tap2": {
        "recognition": "DirectHit",
        "action": "Click",
        "target": [
            1156,
            634
        ],
        "next": [
            "Battle_Tap3"
        ],
        "rate_limit": 0,
        "post_delay": 0
    },
    "Battle_Tap3": {
        "recognition": "DirectHit",
        "action": "Click",
        "target": [
            1156,
            634
        ],
        "next": [
            "Popup_Abnormal",
            "Battle_Lord",
            "Battle_God",
            "Page_Result",
            // 门禁：确认还在战斗页才继续盲点。若游戏被反作弊关闭/弹窗遮挡/
            // 画面切走，全部落空则回 Main 重新定位——否则 DirectHit 死循环
            // 永远出不了战斗链，Main 上的 Popup_Biubiu 等节点永远没机会跑
            "Page_Battle",
            "Main"
        ],
        "rate_limit": 0,
        "post_delay": 0
    },

    // 领主：进度条上出现 TOUCH 横幅 → 点领主按钮。
