{
    // ============================================================
    // 主循环：一个分发节点 + 每页一个识别节点
    //   每轮截图 → 依次比对下面所有页面的标志 → 命中哪个就执行哪个页面的动作
    //   → 动作完回到 Main，重新截图。认不出任何页面时由 Wait 兜底等待。
    //
    // 这样每一步都是独立的「识别 → 点击」：某一步没点中不会有副作用，
    // 下一轮自然重试；也不会因为某个节点识别超时就把整个任务判失败。
    // ============================================================
    // ============================================================
    // 主循环（v2.0.21 架构）：唯一入口 + 统一页面判别
    //   每轮截图 → 按下表优先级依次比对所有页面标志 → 命中哪个就做哪个
    //   页面的「一步」动作 → 动作完回 Main，重新截图再判别。
    //   认不出任何页面（加载/转场）由 Wait 兜底等待。
    //
    // 三条硬规则：
    //   1) 战斗界面最优先（排在所有静态页面之前）—— 战斗是"能动"的，
    //      排在后面会被别的页面识别抢占时间；
    //   2) 弹窗排在页面之前 —— 弹窗会盖住底下的页面，先点掉再看底下；
    //   3) 每个动作节点的 next 一律写 Main，不许写别的链 —— 这是
    //      「走完一次流程就回入口」的落地方式，也是自愈能力的来源：
    //      某一步点击被游戏吞掉，下一轮还是识别到同一页面，自然重试。
    //      唯一例外是删号回撤段（Reset_*，见 02_reset.json 的说明）。
    // ============================================================
    "Main": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        "next": [
            // ---- 弹窗优先：它们会盖住底下的页面 ----
            "Popup_Quiz",
            "Popup_Abnormal",
            "Popup_Biubiu",
            // 删除确认页必须压过通用确认框：删除页也有「确定」按钮，
            // 被 Popup_Confirm 先命中就会绕过「7 天冷静期已勾选」的校验
            "Page_Delete",
            "Page_Confirm2",
            "Popup_Confirm",
            "Popup_CheckIn",
            "Popup_Notice",
            // ---- 战斗最优先 ----
            "Page_Battle",
            // ---- 结算（打完必须马上处理，否则会卡在结果页）----
            "Page_Result",
            // ---- 删号中段页面（正常流程不会出现，动作唯一无歧义）----
            // Accman 必须排在 Account 之前：m_account 模板是「客服中心|账号管理」
            // 按钮条，它在帐号弹窗和账号管理弹窗上都有（账号管理页实测 0.927 误命中），
            // 而 m_accman（账号管理标题）在帐号弹窗只有 0.338 —— 先判 Accman 无副作用。
            "Page_Menu",
            "Page_Accman",
            "Page_Account",
            // ---- 正常流程页面 ----
            "Page_TeamSelect",
            "Page_TeamEdit",
            "Page_Trial",
            "Page_Adventure",
            "Page_Mode",
            "Page_Town",
            "Page_Title",
            // ---- 删号后段页面 ----
            // 故意排在所有模板页面之后：这三个是 OCR（roi 大、比模板贵一个量级），
            // 只在游戏重启后的登录/选号阶段才会出现。放在最后意味着正常流程
            // 命中前面的模板页面就直接返回，不必多跑三次大 roi OCR。
            "Page_Login",
            "Page_Chooser",
            "Page_Signin",
            "Page_Revoke",
            // ---- 谁都认不出（加载、转场）→ 等一下再看 ----
            "Wait"
        ],
        "rate_limit": 0
    },
    // 兜底：DirectHit 必定命中，等一会儿回主循环
    "Wait": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        "pre_delay": 600,
        "next": [
            "Main"
        ],
        "rate_limit": 0
    },

    // ============================================================
