{
    // ============================================================
    // 主循环：一个分发节点 + 每页一个识别节点
    //   每轮截图 → 依次比对下面所有页面的标志 → 命中哪个就执行哪个页面的动作
    //   → 动作完回到 Main，重新截图。认不出任何页面时由 Wait 兜底等待。
    //
    // 这样每一步都是独立的「识别 → 点击」：某一步没点中不会有副作用，
    // 下一轮自然重试；也不会因为某个节点识别超时就把整个任务判失败。
    // ============================================================
    "Main": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        "next": [
            // 弹窗优先级最高：它们会盖住底下的页面
            "Popup_Quiz",
            "Popup_Confirm",
            "Popup_CheckIn",
            "Popup_Notice",
            // 战斗、结算这类"能动"的页面优先
            "Page_Battle",
            "Page_Result",
            // 正常流程页面
            "Page_TeamSelect",
            "Page_TeamEdit",
            "Page_Trial",
            "Page_Adventure",
            "Page_Mode",
            "Page_Town",
            "Page_Title",
            // 谁都认不出（加载、转场）→ 等一下再看
            "Wait"
        ],
        "rate_limit": 0
    },
    // 兜底：DirectHit 必定命中，等一会儿回主循环
    "Wait": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        "pre_delay": 600,
        "next": [
            "Main"
        ],
        "rate_limit": 0
    },

    // ============================================================
