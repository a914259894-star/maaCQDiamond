    // 试炼页：开始按钮灰色有多种成因，不再逐一猜颜色。
    // 规则（用户钦定）：蓝 → 直接开打；OCR 读到「还剩0次」→ 删号；
    // 其余情况一律先点一下「1组」（重复点不会取消选中），点完回来按钮自然变蓝
    "Page_Trial": {
        "recognition": "TemplateMatch",
        "template": [
            "m_trial.png"
        ],
        "roi": [
            0,
            60,
            180,
            70
        ],
        "threshold": 0.85,
        "action": "DoNothing",
        "next": [
            "Trial_Start",
            "Trial_NoCount",
            "Trial_TapGroup",
            "Trial_Wait"
        ]
    },
    "Trial_Wait": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        "pre_delay": 600,
        "next": [
            "Main"
        ],
        "rate_limit": 0
    },
    "Trial_Start": {
        "recognition": "ColorMatch",
        "roi": [
            1120,
            620,
            130,
            50
        ],
        "method": 4,
        "lower": [
            0,
            150,
            180
        ],
        "upper": [
            130,
            255,
            255
        ],
        "count": 1000,
        "action": "Click",
        "target": [
            1187,
            658
        ],
        "post_delay": 1200,
        "next": [
            "Main"
        ]
    },
    // 蓝/0次都不命中 → 无条件点「1组」（v2.0.6 起不再做颜色判断，
    // 实测遮罩/变色场景下暗紫判定会漏；重复点击不会取消选中）
    "Trial_TapGroup": {
        "recognition": "DirectHit",
        "action": "Click",
        "target": [
            40,
            252
        ],
        "post_delay": 800,
        "next": [
            "Main"
        ],
        "rate_limit": 0
    },
    // 1组已选中但按钮仍是灰 → 只剩次数用完这一种可能。
    // 用 OCR 确认按钮上方红字确实是「还剩0次」才进删号。
    // 注意红字「还剩N次」在次数>0时也存在（实测 step_trial.png），所以必须读出 0
    "Trial_NoCount": {
        "recognition": "OCR",
        "expected": [
            "0次",
            "还剩0次"
        ],
        "roi": [
            1100,
            594,
            120,
            40
        ],
        "threshold": 0.3,
        "action": "DoNothing",
        "next": [
            "Reset_Start"
        ]
    },
    // 「灵魂二重奏」队伍编成：右下「开始」
    //   蓝 → 队伍已配好，点；灰 → 队伍是空的，点也没用，停下让人配队
    "Page_TeamEdit": {
