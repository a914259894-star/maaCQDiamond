{
    // OCR 通用节点：只作为识别算法用，本身不做任何动作
    "OCR_Full": {
        "recognition": "OCR",
        "expected": [
            ".*"
        ],
        "action": "DoNothing"
    },

    // 惊喜问答：四个角色依次跑过，要回答右侧角色排第几。
    // 答错会被限制进入（实测从 43 秒涨到 8 分钟），自动乱猜只会越来越糟，
    // 所以这里直接停任务交给人工，答完再重新启动。
    "Popup_Quiz": {
        "recognition": "TemplateMatch",
        "template": [
            "SurpriseQuiz.png"
        ],
        "roi": [
            300,
            0,
            700,
            160
        ],
        "threshold": 0.85,
        "action": "StopTask",
        "next": []
    },

    // 通用确认框：「队伍锁定」「开启练习模式」「删除结束」等都长这样，
    // 统一识别「确认 / 确定」并点它
    "Popup_Confirm": {
        "recognition": "OCR",
        "expected": [
            "确认",
            "确定"
        ],
        "roi": [
            380,
            450,
            540,
            220
        ],
        "action": "Click",
        "post_delay": 900,
        "next": [
            "Main"
        ]
    },

    // 每日签到：登录后会盖在主城上，点右上角 × 关掉
    "Popup_CheckIn": {
        "recognition": "TemplateMatch",
        "template": [
            "CheckInPanel.png"
        ],
        "roi": [
            0,
