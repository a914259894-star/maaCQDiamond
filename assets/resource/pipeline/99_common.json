{
    // OCR 通用节点：只作为识别算法用，本身不做任何动作
    "OCR_Full": {
        "recognition": "OCR",
        "expected": [
            ".*"
        ],
        "action": "DoNothing"
    },

    // 惊喜问答：四个角色依次跑过，要回答右侧角色排第几。
    // 答错会被限制进入（实测从 43 秒涨到 8 分钟），自动乱猜只会越来越糟，
    // 所以这里直接停任务交给人工，答完再重新启动。
    "Popup_Quiz": {
        "recognition": "TemplateMatch",
        "template": [
            "SurpriseQuiz.png"
        ],
        "roi": [
            300,
            0,
            700,
            160
        ],
        "threshold": 0.85,
        "action": "StopTask",
        "next": []
    },

    // 反作弊弹窗（「非正常使用！检测到不正当游戏行为，游戏将被关闭。」）：
    // 点「确认」后游戏会自行关闭，biubiu 加速器稍后会自动重开到 TAP TO START，
    // 由 Page_Title 接管。模板裁自真机弹窗（正例 1.0 / 负例 ≤0.361）。
    // 战斗链里也挂着此节点：弹窗若在战斗中出现，否则要等战斗超时才能自愈
    "Popup_Abnormal": {
        "recognition": "TemplateMatch",
        "template": [
            "m_abnormal.png"
        ],
        "roi": [
            450,
            130,
            400,
            120
        ],
        "threshold": 0.8,
        "action": "Click",
        "target": [
            640,
            547
        ],
        "post_delay": 2500,
        "next": [
            "Main"
        ],
        "rate_limit": 0
    },

    // biubiu 加速器详情页：反作弊关游戏后 biubiu 不会自动重开，
    // 会（先放广告）停在这个页面等人工点右下角「打开游戏」。
    // 用 OCR 认字而非模板（用户截图非标准比例，模板缩放不可靠），
    // roi 放宽到竖屏内容底部区域，「停止加速」等文字不会误命中
    "Popup_Biubiu": {
        "recognition": "OCR",
        "expected": [
            "打开游戏"
        ],
        "roi": [
            300,
            560,
            680,
            160
        ],
        "action": "Click",
        "target": true,
        "post_delay": 3000,
        "next": [
            "Main"
        ],
        "rate_limit": 0
    },

    // 通用确认框：「队伍锁定」「开启练习模式」（仅提示，只有确认）「删除结束」
    // 等都长这样，统一识别「确认 / 确定」并点它
    "Popup_Confirm": {
        "recognition": "OCR",
        "expected": [
            "确认",
            "确定"
        ],
        "roi": [
            380,
            450,
            540,
            220
        ],
        "action": "Click",
        "post_delay": 900,
        "next": [
            "Main"
        ]
    },

    // 每日签到：登录后会盖在主城上，点右上角 × 关掉
    "Popup_CheckIn": {
        "recognition": "TemplateMatch",
        "template": [
            "CheckInPanel.png"
        ],
        "roi": [
            0,
            0,
            300,
            150
        ],
        "threshold": 0.85,
        "action": "Click",
        "target": [
            1231,
            41
        ],
        "post_delay": 900,
        "next": [
            "Main"
        ]
    },

    // 公告：登录后弹出，点右上角 × 关掉
    "Popup_Notice": {
        "recognition": "TemplateMatch",
        "template": [
            "NoticeClose.png"
        ],
        "roi": [
            1040,
            0,
            240,
            80
        ],
        "threshold": 0.85,
        "action": "Click",
        "target": [
            1235,
            40
        ],
        "post_delay": 700,
        "next": [
            "Main"
        ]
    }
}
