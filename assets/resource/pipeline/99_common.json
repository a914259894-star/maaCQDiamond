{
    // OCR 通用节点：只作为识别算法用，本身不做任何动作
    "OCR_Full": {
        "recognition": "OCR",
        "expected": [
            ".*"
        ],
        "action": "DoNothing"
    },

    // 惊喜问答：四个角色依次跑过，要回答右侧角色排第几。
    // 题目和答案是动态的，pipeline 无法可靠作答，而且答错会被限制进入
    // （实测从 43 秒涨到 8 分钟），所以不能乱猜。
    //
    // 处理方式（v2.0.22，用户钦定）：出现就直接杀掉游戏进程，靠「重启掉问答」绕过。
    //   1) StopApp 按包名关掉游戏（比连按 BACK 干脆，不会停在游戏内的中间页）
    //   2) 游戏关闭后 sim 退回 biubiu 详情页（与反作弊弹窗点确认后的路径一致）
    //   3) 回 Main 继续判别 → Popup_Biubiu 认出「打开游戏」→ 点击重开
    //   4) 游戏重启到 TAP TO START → Page_Title 接回主循环
    "Popup_Quiz": {
        "recognition": "TemplateMatch",
        "template": [
            "SurpriseQuiz.png"
        ],
        "roi": [
            300,
            0,
            700,
            160
        ],
        "threshold": 0.85,
        "action": "StopApp",
        "package": "com.nhnent.SKQUEST",
        "post_delay": 4000,
        "next": [
            "Main"
        ],
        "rate_limit": 0
    },

    // 反作弊弹窗（「非正常使用！检测到不正当游戏行为，游戏将被关闭。」）。
    // 完整链路（用户实测钦定，弹窗只在主城出现）：
    //   点「确认」→ 游戏自行关闭 → biubiu 放广告（期间 Main→Wait 空转等待）
    //   → biubiu 详情页出现 → Popup_Biubiu 点「打开游戏」
    //   → 游戏重启到 TAP TO START → Page_Title 点掉 → 回主循环。
    //
    // v2.0.16：改用 OCR 认「非正常使用」（v2.0.9 的模板裁自 1138x637 窗口截图，
    // 缩放后与真机 720p 帧有色彩/渲染差异，真机日志 571 次尝试 0 命中）。
    // OCR 离线实测（同一张弹窗截图）：「非正常使用！」score 0.97、「确认」score 1.0
    // box [605,524,85,51] → 点击中心 (647,549)
    "Popup_Abnormal": {
        "recognition": "OCR",
        "expected": [
            "非正常使用"
        ],
        "roi": [
            400,
            120,
            480,
            140
        ],
        "threshold": 0.3,
        "action": "Click",
        "target": [
            647,
            549
        ],
        "post_delay": 2500,
        "next": [
            "Main"
        ],
        "rate_limit": 0
    },

    // biubiu 加速器详情页（反作弊关游戏后出现）：先放广告，然后停在这个页面
    // 等着点右下角「打开游戏」。
    // v2.0.17 修复：biubiu 详情页是竖屏，模拟器帧会整体转成 720x1280 竖屏
    // （v2.0.16 的 roi [280,540,720,180] 按横屏 1280x720 写的，按钮实际在
    // (498,1210) 附近，一次都罩不到 → 真机 0 命中）。改为去掉 roi 全屏找字，
    // target:true 直接点识别框（文字就在按钮上），横竖屏通吃。
    // v2.0.25：加 pre_delay 3000。实测（v2.0.22 日志 15:08）游戏关闭 → 切 biubiu
    // 期间 MuMu host 侧接口会瞬态失效 20 多秒（get_display_id=-1、截图失败），
    // MFAAvalonia 监控到空帧会在恢复的第一帧重建控制器，此时点击极易撞上
    // 旧控制器输入通道已失效的窗口 → touch_down ret=3 → MaaFW 判 action 失败
    // → 整条任务 FAILED。缓冲 3 秒避开恢复期（页面本来就要停留，无代价）。
    "Popup_Biubiu": {
        "recognition": "OCR",
        "expected": [
            "打开游戏"
        ],
        "action": "Click",
        "target": true,
        "pre_delay": 3000,
        "post_delay": 3000,
        "next": [
            "Main"
        ],
        "rate_limit": 0
    },

    // 通用确认框：「队伍锁定」「开启练习模式」（仅提示，只有确认）「删除结束」
    // 等都长这样，统一识别「确认 / 确定」并点它
    "Popup_Confirm": {
        "recognition": "OCR",
        "expected": [
            "确认",
            "确定"
        ],
        "roi": [
            380,
            450,
            540,
            220
        ],
        "action": "Click",
        "post_delay": 900,
        "next": [
            "Main"
        ]
    },

    // 每日签到：登录后会盖在主城上，点右上角 × 关掉
    "Popup_CheckIn": {
        "recognition": "TemplateMatch",
        "template": [
            "CheckInPanel.png"
        ],
        "roi": [
            0,
            0,
            300,
            150
        ],
        "threshold": 0.85,
        "action": "Click",
        "target": [
            1231,
            41
        ],
        "post_delay": 900,
        "next": [
            "Main"
        ]
    },

    // 公告：登录后弹出，点右上角 × 关掉
    "Popup_Notice": {
        "recognition": "TemplateMatch",
        "template": [
            "NoticeClose.png"
        ],
        "roi": [
            1040,
            0,
            240,
            80
        ],
        "threshold": 0.85,
        "action": "Click",
        "target": [
            1235,
            40
        ],
        "post_delay": 700,
        "next": [
            "Main"
        ]
    }
}
