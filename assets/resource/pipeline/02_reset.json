{
    // ============================================================
    // 删号流程（v2.0.21 架构重构）
    //
    // 【总原则】唯一入口 Main 统一判别页面：每轮截图 → 依次比对所有页面标志
    //   → 命中哪个就做哪个页面的「一步」动作 → 回 Main 重新判别。
    //   战斗界面最优先，认不出任何页面由 Wait 兜底。
    //
    // 本文件只保留两部分：
    //
    // A. 回撤段（Reset_*）
    //    试炼页 ×→ 冒险页 ×→ 模式页「城镇」→ 城镇 →点右上菜单图标
    //    这是全流程唯一必须依赖「上下文」的一小段，因为「城镇页」有两个
    //    互相冲突的合法动作：正常流程点右下「开始」去试炼，删号流程点右上
    //    「菜单」。两者画面完全一样，纯 pipeline 无法区分。
    //    → 所以只在这一段保留链式推进；**菜单弹窗一出现（Page_Menu）
    //      立刻交回 Main**，后续全部由统一判别驱动，不再有长自循环。
    //
    // B. 删号中段页面（Page_Menu / Page_Account / ... / Page_Revoke）
    //    这些页面在正常流程里根本不会出现，每个页面的动作唯一、无歧义，
    //    因此全部挂在 Main 的 next 里，走一步回一次入口。
    //    好处：任何一步点击被游戏吞掉，下一轮 Main 重新判别到的还是这个页面，
    //    自然重试；也不会像 v2.0.17/v2.0.19 那样困在链里对错误目标空点到死。
    // ============================================================

    // ============================================================
    // A. 回撤段：从试炼页退到城镇并打开菜单
    // ============================================================
    // 入口：试炼页 OCR 读到「还剩0次」时由 Trial_NoCount 跳进来
    //   （也可作为 interface.json 里「重置次数（删号）」任务的入口单独调试）
    "Reset_Start": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        "next": [
            "Reset_Home"
        ],
        "rate_limit": 0
    },

    // 回撤段分发：按当前页面决定往哪退一步
    //   已在菜单 → Page_Menu（命中即交回 Main 接管）
    //   在城镇   → 点右上角菜单图标
    //   在试炼/冒险/模式 → 各自点退回上一层
    //   都不认识 → 等一下再看
    "Reset_Home": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        "pre_delay": 400,
        "next": [
            "Popup_Abnormal",
            "Popup_Biubiu",
            "Page_Result",
            "Page_Menu",
            "Reset_TapMenuIcon",
            "Reset_BackTrial",
            "Reset_BackAdv",
            "Reset_BackMode",
            "Reset_Wait"
        ],
        "rate_limit": 0,
        "timeout": -1
    },
    // 城镇：点右上角菜单图标 (1242,45) → 菜单弹窗
    "Reset_TapMenuIcon": {
        "recognition": "TemplateMatch",
        "template": [
            "m_town.png"
        ],
        "roi": [
            0,
            540,
            500,
            150
        ],
        "threshold": 0.85,
        "action": "Click",
        "target": [
            1242,
            45
        ],
        "post_delay": 1200,
        "next": [
            "Popup_Abnormal",
            "Popup_Biubiu",
            "Page_Result",
            "Reset_Home"
        ]
    },
    // 试炼页右上角 × → 回冒险
    "Reset_BackTrial": {
        "recognition": "TemplateMatch",
        "template": [
            "m_trial.png"
        ],
        "roi": [
            0,
            60,
            180,
            70
        ],
        "threshold": 0.85,
        "action": "Click",
        "target": [
            1250,
            36
        ],
        "post_delay": 1400,
        "next": [
            "Popup_Abnormal",
            "Popup_Biubiu",
            "Page_Result",
            "Reset_Home"
        ]
    },
    // 冒险页右上角 × → 回模式选择
    "Reset_BackAdv": {
        "recognition": "TemplateMatch",
        "template": [
            "m_adventure.png"
        ],
        "roi": [
            10,
            0,
            130,
            70
        ],
        "threshold": 0.85,
        "action": "Click",
        "target": [
            1250,
            36
        ],
        "post_delay": 1400,
        "next": [
            "Popup_Abnormal",
            "Popup_Biubiu",
            "Page_Result",
            "Reset_Home"
        ]
    },
    // 模式选择页左下角「城镇」
    "Reset_BackMode": {
        "recognition": "TemplateMatch",
        "template": [
            "m_mode.png"
        ],
        "roi": [
            70,
            220,
            150,
            100
        ],
        "threshold": 0.85,
        "action": "Click",
        "target": [
            130,
            600
        ],
        "post_delay": 1600,
        "next": [
            "Popup_Abnormal",
            "Popup_Biubiu",
            "Page_Result",
            "Reset_Home"
        ]
    },
    // 回撤段兜底：加载/转场时等一下重新定位
    "Reset_Wait": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        "pre_delay": 800,
        "next": [
            "Popup_Abnormal",
            "Popup_Biubiu",
            "Page_Result",
            "Reset_Home"
        ],
        "rate_limit": 0
    },

    // ============================================================
    // B. 删号中段页面：挂在 Main 上，走一步回一次入口
    // ============================================================
    // 菜单弹窗 → 点第二排中间的「帐号」图标。
    // 命中这个节点就意味着「删号入口已经打开」，回撤段到此结束。
    "Page_Menu": {
        "recognition": "TemplateMatch",
        "template": [
            "m_menu.png"
        ],
        "roi": [
            560,
            40,
            180,
            80
        ],
        "threshold": 0.85,
        "action": "Click",
        "target": [
            643,
            441
        ],
        "post_delay": 1200,
        "next": [
            "Main"
        ]
    },
    // 帐号弹窗 → 点右下「帐号管理」
    "Page_Account": {
        "recognition": "TemplateMatch",
        "template": [
            "m_account.png"
        ],
        "roi": [
            520,
            540,
            420,
            100
        ],
        "threshold": 0.85,
        "action": "Click",
        "target": [
            826,
            587
        ],
        "post_delay": 1200,
        "next": [
            "Main"
        ]
    },
    // 账号管理弹窗 → 点红色「删除账号」
    "Page_Accman": {
        "recognition": "TemplateMatch",
        "template": [
            "m_accman.png"
        ],
        "roi": [
            540,
            40,
            260,
            90
        ],
        "threshold": 0.85,
        "action": "Click",
        "target": [
            747,
            336
        ],
        "post_delay": 1200,
        "next": [
            "Main"
        ]
    },
    // 删除确认页：先校验「7 天冷静期」勾选条是不是绿的
    //   绿（已勾选，删了也能撤销）→ 才允许点「确定」
    //   非绿 → 直接停任务交给人工。不自动去勾：勾错状态提交删除的风险不可接受。
    // 注意：本节点必须排在 Popup_Confirm 之前，否则删除页的「确定」按钮
    //   会被通用确认框先命中，绕过这段校验。
    "Page_Delete": {
        "recognition": "TemplateMatch",
        "template": [
            "m_delete.png"
        ],
        "roi": [
            530,
            110,
            260,
            110
        ],
        "threshold": 0.85,
        "action": "DoNothing",
        "post_delay": 0,
        "next": [
            "Page_Delete_Green",
            "Page_Delete_Stop"
        ],
        "rate_limit": 0
    },
    // 勾选条是绿色 → 点「确定」(757,575)
    "Page_Delete_Green": {
        "recognition": "ColorMatch",
        "roi": [
            470,
            415,
            340,
            55
        ],
        "method": 4,
        "lower": [
            85,
            110,
            40
        ],
        "upper": [
            170,
            200,
            115
        ],
        "count": 4000,
        "action": "Click",
        "target": [
            757,
            575
        ],
        "post_delay": 2000,
        "next": [
            "Main"
        ],
        "rate_limit": 0
    },
    // 勾选条不是绿色 → 停任务，等人工确认勾选状态后重跑
    "Page_Delete_Stop": {
        "recognition": "TemplateMatch",
        "template": [
            "m_delete.png"
        ],
        "roi": [
            530,
            110,
            260,
            110
        ],
        "threshold": 0.85,
        "action": "StopTask",
        "next": []
    },
    // 第二层确认弹窗（「确认删除账户 / 真的要退出吗？」按钮为「取消 / 确认」）
    // OCR 只认「确认」二字：第一页的按钮叫「确定」，不会误触。
    // roi 收在按钮一行，避免碰到正文。
    "Page_Confirm2": {
        "recognition": "OCR",
        "expected": [
            "确认"
        ],
        "roi": [
            380,
            490,
            540,
            110
        ],
        "threshold": 0.3,
        "action": "Click",
        "target": true,
        "post_delay": 2000,
        "next": [
            "Main"
        ]
    },
    // 游戏登录页 → 点 «Sign in with Google»
    "Page_Login": {
        "recognition": "TemplateMatch",
        "template": [
            "m_login.png"
        ],
        "roi": [
            530,
            110,
            260,
            110
        ],
        "threshold": 0.85,
        "action": "Click",
        "target": [
            640,
            240
        ],
        "post_delay": 2000,
        "next": [
            "Main"
        ]
    },
    // 谷歌「选择账号」列表 → 点最后一个含 @ 的邮箱行。
    // v2.0.15 实测定版：OCR 认含 @ 的行，order_by=Vertical 自上而下，index=-1 取末行
    // （「添加其他账号」不含 @，不会被选中）。
    // 教训（v2.0.12）：不要加「先认标题再分派」的门——标题 roi 是猜的，罩不住就全卡死。
    "Page_Chooser": {
        "recognition": "OCR",
        "expected": [
            ".+@.+"
        ],
        "roi": [
            300,
            320,
            680,
            250
        ],
        "threshold": 0.3,
        "order_by": "Vertical",
        "index": -1,
        "action": "Click",
        "target": true,
        "post_delay": 3000,
        "next": [
            "Main"
        ],
        "rate_limit": 0
    },
    // 误入 Google 手动登录页（点了「添加其他帐号」）→ 按 BACK 返回选号页重选。
    // BACK 键码 4（Android KeyEvent）
    "Page_Signin": {
        "recognition": "OCR",
        "expected": [
            "邮箱或电话号码",
            "创建账号"
        ],
        "roi": [
            200,
            300,
            880,
            220
        ],
        "threshold": 0.3,
        "action": "ClickKey",
        "key": 4,
        "post_delay": 1500,
        "next": [
            "Main"
        ],
        "rate_limit": 0
    },
    // 「该账号处于删除流程中，是否撤销删除？」→ 点「撤销」。
    // roi 收在两个按钮一行（撤销按钮中心约 744,526），正文里的「撤销删除」不会进来
    "Page_Revoke": {
        "recognition": "OCR",
        "expected": [
            "撤销",
            "取消删除",
            "恢复账号"
        ],
        "roi": [
            400,
            480,
            500,
            100
        ],
        "threshold": 0.3,
        "action": "Click",
        "target": true,
        "post_delay": 2500,
        "next": [
            "Main"
        ]
    }
}
