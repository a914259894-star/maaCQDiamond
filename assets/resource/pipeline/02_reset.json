        ]
    },

    // 删除确认页：先看冷静期勾选条是不是绿的（绿 = 已勾选，可以继续）
    "Reset_Delete": {
        "recognition": "TemplateMatch",
        "template": [
            "m_delete.png"
        ],
        "roi": [
            530,
            110,
            260,
            110
        ],
        "threshold": 0.85,
        "action": "DoNothing",
        "post_delay": 0,
        "next": [
            "Reset_DeleteChecked",
            "Reset_NotChecked",
            "Reset_Home"
        ],
        "rate_limit": 0
    },
    // 勾选条是绿色 → 说明「7 天冷静期」已勾上（这是删号后能撤销的前提）
    "Reset_DeleteChecked": {
        "recognition": "ColorMatch",
        "roi": [
            470,
            415,
            340,
            55
        ],
        "method": 4,
        "lower": [
            85,
            110,
            40
        ],
        "upper": [
            170,
            200,
            115
        ],
        "count": 4000,
        "action": "DoNothing",
        "next": [
            "Reset_Confirm"
        ],
        "rate_limit": 0
    },
    // 勾选条不是绿色（未勾选）→ 按用户要求直接停任务，由人工判断后再跑。
    // 不自动去勾：勾错状态提交删除的风险不可接受。
    "Reset_NotChecked": {
        "recognition": "TemplateMatch",
        "template": [
            "m_delete.png"
        ],
        "roi": [
            530,
            110,
            260,
            110
        ],
        "threshold": 0.85,
        "action": "StopTask",
        "next": []
    },
    // 点「确定」
    "Reset_Confirm": {
        "recognition": "TemplateMatch",
        "template": [
            "m_delete.png"
        ],
        "roi": [
            530,
            110,
            260,
            110
        ],
        "threshold": 0.85,
        "action": "Click",
        "target": [
            757,
            575
        ],
        "post_delay": 2000,
        "next": [
            "Reset_AfterDelete",
            "Reset_Confirm"
        ]
    },

    // 视频 215.5s：点确定后会再弹「确认删除账户 / 真的要退出吗？」，
    // 按钮是「取消 / 确认」。OCR 只认「确认」二字（第一页的按钮叫「确定」，不会误触），
    // roi 收在按钮一行，避免碰到正文。
    "Reset_SecondConfirm": {
        "recognition": "OCR",
        "expected": [
            "确认"
        ],
        "roi": [
            380,
            490,
            540,
            110
        ],
        "threshold": 0.3,
        "action": "Click",
        "target": true,
        "post_delay": 2000,
        "next": [
            "Reset_ExitWait",
            "Reset_SecondConfirm"
        ]
    },

    // 点完确认后游戏退出重启（视频 217-219s：账号管理弹窗 → 退出动画 → LOAD），
    // 这里单纯等它落到登录页
    "Reset_ExitWait": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        "pre_delay": 2500,
        "next": [
            "Reset_Login",
            "Reset_Chooser",
            "Reset_Revoke",
            // 第二层确认弹窗 OCR 偶发漏读时也要能重试，否则困在自我等待里
            "Reset_SecondConfirm",
            "Reset_ExitWait"
        ],
        "rate_limit": 0
    },

    // 确定之后状态不固定：可能弹第二层确认，也可能已在退出/登录途中
    "Reset_AfterDelete": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        "pre_delay": 800,
        "next": [
            "Reset_SecondConfirm",
            "Reset_Delete",
            "Reset_Login",
            "Reset_Chooser",
            "Reset_Revoke",
            "Reset_AfterDelete"
        ],
        "rate_limit": 500,
        "timeout": -1
    },
    // 游戏登录页 → 点 «Sign in with Google»
    "Reset_Login": {
        "recognition": "TemplateMatch",
        "template": [
            "m_login.png"
        ],
        "roi": [
            530,
            110,
            260,
            110
        ],
        "threshold": 0.85,
        "action": "Click",
        "target": [
            640,
            240
        ],
        "post_delay": 2000,
        "next": [
            "Reset_Chooser",
            "Reset_Login",
            // 点完登录后画面在过渡 → 交给 AfterLogin 统一重定向
            "Reset_AfterLogin"
        ]
    },
    // 谷歌「选择账号」页 —— 三层结构（v2.0.12）：
    //   1. Reset_Chooser 只做页面识别（认标题「选择账号」），分派给具体点击节点
    //   2. Reset_Chooser_Frost 优先：OCR 认目标账号名「frost」，点名字行=行的中部，
    //      离行边界最远（实测 20:04 邮箱行点击被列表动画/位移吞掉，点进了「添加其他帐号」，
    //      Google 进入手动登录页「邮箱或电话号码/创建账号」）
    //   3. Reset_Chooser_Email 兜底：认含 @ 的最后一行（顺序 Vertical + index -1）
    // 另有 Reset_Signin 恢复节点：误进手动登录页时按 BACK 返回选号页重选
    "Reset_Chooser": {
        "recognition": "OCR",
        "expected": [
            "选择账号",
            "选择帐号"
        ],
        "roi": [
            300,
            300,
            680,
            90
        ],
        "threshold": 0.3,
        "action": "DoNothing",
        "next": [
            "Reset_Chooser_Frost",
            "Reset_Chooser_Email",
            "Reset_Chooser"
        ],
        "rate_limit": 0
    },
    "Reset_Chooser_Frost": {
        "recognition": "OCR",
        "expected": [
            "frost"
        ],
        "roi": [
            300,
            320,
            680,
            250
        ],
        "threshold": 0.3,
        "action": "Click",
        "target": true,
        "post_delay": 3000,
        "next": [
            "Reset_AfterLogin",
            "Reset_Chooser"
        ],
        "rate_limit": 0
    },
    "Reset_Chooser_Email": {
        "recognition": "OCR",
        "expected": [
            ".+@.+"
        ],
        "roi": [
            300,
            320,
            680,
            250
        ],
        "threshold": 0.3,
        "order_by": "Vertical",
        "index": -1,
        "action": "Click",
        "target": true,
        "post_delay": 3000,
        "next": [
            "Reset_AfterLogin",
            "Reset_Chooser"
        ],
        "rate_limit": 0
    },
    // 误入 Google 手动登录页（点了「添加其他帐号」）→ 按 BACK 返回选号页重选
    // BACK 键码 4（Android KeyEvent）
    "Reset_Signin": {
        "recognition": "OCR",
        "expected": [
            "邮箱或电话号码",
            "创建账号"
        ],
        "roi": [
            200,
            300,
            880,
            220
        ],
        "threshold": 0.3,
        "action": "ClickKey",
        "key": 4,
        "post_delay": 1500,
        "next": [
            "Reset_Chooser",
            "Reset_Login",
            "Main"
        ],
        "rate_limit": 0
    },
    // 选完号：可能弹「账号删除引导」要撤销（视频 225.5s），
    // 也可能短暂回到登录页再弹；都不在就走 Main 正常流程。
    // Reset_Signin 放最前：误入手动登录页立即按 BACK 返回重选
    "Reset_AfterLogin": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        "pre_delay": 800,
        "next": [
            "Reset_Signin",
            "Reset_Revoke",
            "Reset_Login",
            "Reset_Chooser",
            "Main",
            "Reset_AfterLogin"
        ],
        "rate_limit": 500,
        "timeout": -1
    },
    // 「账号删除引导 / 该账号处于删除流程中。是否撤销删除？」→ 点「撤销」。
    // roi 收在两个按钮一行（撤销按钮中心约 744,526），正文里的「撤销删除」不会进来
    "Reset_Revoke": {
        "recognition": "OCR",
        "expected": [
            "撤销",
