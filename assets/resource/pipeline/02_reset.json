        "next": [
            "Reset_AfterLogin"
        ]
    },
    // 登录完成后可能弹「撤销删除」，也可能直接进游戏；交给 Main 正常跑
    "Reset_AfterLogin": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        "pre_delay": 1000,
        "next": [
            "Reset_Revoke",
            "Popup_Confirm",
            "Main"
        ],
        "rate_limit": 500,
        "timeout": -1
    },
    // 冷静期撤销：登录后如果提示「账号将被删除 / 是否撤销」，点撤销
