{
    // ============================================================
    // 删号恢复次数链路
    //
    // 试炼次数用完后：回主城 → 菜单 → 帐号 → 帐号管理 → 删除帐号
    //   → 勾选「有 7 天的删除冷静期」→ 确定 → 重新用谷歌账号登录 → 回主循环
    //
    // 每个点击都是「点完等下一页标志出现，没出现就在同一页再点一次」，
    // 因此不会因为一次点击被游戏吞掉就整条链路卡死。
    // ============================================================

    // 入口：只为把流程收拢到一个节点
    "Reset_Start": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        "next": [
            "Reset_Home"
        ],
        "rate_limit": 0
    },

    // 归位到主城菜单：按优先级依次尝试「已在菜单 → 点帐号」「在主城 → 点菜单图标」
    //   「在试炼/冒险/模式 → 一路返回」「都不认识 → 等一下再看」
    "Reset_Home": {
        "recognition": "DirectHit",
        "action": "DoNothing",
        "pre_delay": 400,
        "next": [
            "Reset_MenuOpen",
            "Reset_TapMenuIcon",
            "Reset_BackTrial",
            "Reset_BackAdv",
            "Reset_BackMode",
            "Reset_Wait"
        ],
        "rate_limit": 0,
        "timeout": -1
    },
    // 菜单弹窗里点「帐号」图标（第二排中间）
    "Reset_MenuOpen": {
        "recognition": "TemplateMatch",
        "template": [
            "m_menu.png"
        ],
