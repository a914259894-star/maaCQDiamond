{
    // 克鲁赛德战记（Crusaders Quest）试炼循环工具
    // 文档：https://maafw.com/docs/3.3-ProjectInterfaceV2
    "interface_version": 2,
    "name": "克鲁赛德战记 试炼循环",
    "description": "自动进入试炼 → 战斗（盲点方块条 + 领主/女神 TOUCH）→ 结算 → 继续；次数用尽后自动删号（保留 7 天冷静期）并重新登录，恢复次数继续循环。",
    "contact": "QQ群: 123456789",
    "license": "MIT",
    "welcome": "使用前请确认：游戏已在模拟器中运行并处于「主城」界面。截图方式保持默认即可，本工具不做任何改动。",
    "github": "https://github.com/a914259894-star/maaCQDiamond",
    "version": "2.0.20",
    "controller": [
        {
            "name": "模拟器",
            "type": "Adb",
            // 截图统一缩放到短边 720（即 1280x720），标志图与坐标都按此分辨率制作
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        }
    ],
    "task": [
        {
            "name": "试炼循环",
            "entry": "Main"
        },
        {
            // 单独跑「回到主城 → 菜单 → 帐号 → 删除帐号 → 重新登录」这一段，
            // 用于验证删号链路；会真的提交删除（勾选 7 天冷静期，可撤销）
            "name": "重置次数（删号）",
            "entry": "Reset_Start"
        }
    ]
}
